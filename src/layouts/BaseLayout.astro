---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SideMenu from '@/components/layout/SideMenu.astro';
import Layout from '@/layouts/Layout.astro';

const { title, subTitle, description, keywords } = Astro.props;
---

<Layout title={title} description={description} keywords={keywords}>
  <div class="flex flex-col justify-around min-h-screen">
    <header>
      <Header />
    </header>
    <SideMenu />
    <main id="contenido" class="flex flex-col items-center max-w-5xl mx-auto mb-10 mt-24 px-4 md:mt-28">
      <h1
        class="text-center max-w-3xl my-5 text-3xl leading-tight md:my-6 md:text-5xl font-bold text-fixed"
      >
        {subTitle ? subTitle : title}
      </h1>
      <slot />
    </main>
    <Footer />
  </div>
</Layout>
