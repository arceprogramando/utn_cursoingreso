---
import SiteFrame from '@/layouts/SiteFrame.astro';

const { title, subTitle, description, keywords } = Astro.props;
---

<SiteFrame title={title} description={description} keywords={keywords}>
  <main id="contenido" class="mx-auto mb-10 mt-24 flex max-w-5xl flex-col items-center px-4 md:mt-28">
    <h1 class="text-fixed my-5 max-w-3xl text-center text-3xl leading-tight font-bold md:my-6 md:text-5xl">
      {subTitle ? subTitle : title}
    </h1>
    <slot />
  </main>
</SiteFrame>
