---
import { Icon } from 'astro-icon/components';

interface Program {
  title: string;
  description: string;
  icon?: string;
  href?: string;
}

const Programs: Program[] = [
  { title: 'Programación', description: 'Aprende la lógica de la programación desde cero.', icon: 'code', href: '/tags/programacion' },
  { title: 'Trabajo en Equipo', description: 'Desarrolla habilidades en colaboración.', icon: 'users', href: '/community-projects' },
  { title: 'Plan 2024', description: 'Horas de clase, trabajo autónomo y créditos.', icon: 'book', href: '/#plan' },
  { title: 'Certificación', description: 'Certificación de la UTN.', icon: 'trophy', href: '/#Certificación' },
  { title: 'Práctica Real', description: 'Proyectos reales para la práctica.', icon: 'laptop', href: '/community-projects' },
  { title: 'Metodología', description: 'Enfoque práctico y teórico balanceado.', icon: 'brain' , href:'/#Metodologia' },
  ];
---

<style>
  .program-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
    margin: 1.75rem 0 0.5rem;
  }

  @media (min-width: 640px) {
    .program-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .program-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.6rem;
    min-height: 100%;
    padding: 1.15rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg-secondary) 88%, transparent);
    color: var(--text-primary);
    text-decoration: none;
    box-shadow: 0 10px 28px var(--shadow);
  }

  .program-card:hover {
    border-color: var(--accent-2);
  }

  .program-card .program-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .program-card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1rem;
  }
</style>

<div class="program-grid">
  {
    Programs.map((program) => (
      <a href={program.href} class="program-card">
        <Icon name={program.icon} width={40} height={40} aria-hidden="true" />
        <p class="program-title">{program.title}</p>
        <p>{program.description}</p>
      </a>
    ))
  }
</div>
