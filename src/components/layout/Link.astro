---
import type { Link } from '@/data/layouts/links';

interface Props extends Link {
  current?: boolean;
  variant?: 'menu' | 'bar';
}

const { href, title, current = false, variant = 'menu' } = Astro.props;
---

<a
  href={href}
  class:list={['nav-link', `nav-link--${variant}`, { 'nav-link--current': current }]}
  aria-current={current ? 'page' : undefined}
>
  {title}
</a>

<style>
  .nav-link {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
  }

  .nav-link:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .nav-link--bar {
    display: inline-flex;
    width: auto;
    min-height: 2.5rem;
    padding: 0.35rem 0.7rem;
    color: var(--text-secondary);
    font-size: 0.78rem;
  }

  .nav-link--bar:hover {
    color: var(--text-primary);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .nav-link--menu.nav-link--current {
    border-color: color-mix(in srgb, var(--accent-2) 55%, transparent);
    background: color-mix(in srgb, var(--accent-2) 16%, transparent);
    box-shadow: inset 3px 0 0 var(--accent-2);
  }

  .nav-link--bar.nav-link--current {
    color: var(--text-primary);
    border-color: color-mix(in srgb, var(--accent-2) 70%, transparent);
    background: color-mix(in srgb, var(--accent-2) 16%, transparent);
    box-shadow: inset 0 -2px 0 var(--accent-2);
  }
</style>
