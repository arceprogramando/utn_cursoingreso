---
import Social from '@/components/Social.astro';

const socialMedias = [
  {
    red: 'github',
    perfil: 'https://github.com/arceprogramando/utn_cursoingreso',
    alt: 'Repositorio del sitio en GitHub',
  },
  {
    red: 'portfolio',
    perfil: 'https://arceprog.dev',
    alt: 'Portfolio de Felipe Arce',
  },
];
---

<footer class="site-footer">
  <nav aria-label="Redes y repositorio">
    <ul>
      {
        socialMedias.map((media) => (
          <li>
            <Social platform={media.perfil} red={media.red} icon={media.red} alt={media.alt} />
          </li>
        ))
      }
    </ul>
  </nav>
  <p>Sitio independiente de estudiantes. No es un canal oficial de la UTN.</p>
</footer>

<style>
  .site-footer {
    padding: 1.5rem 1rem 2rem;
    text-align: center;
  }

  .site-footer ul {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer p {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
</style>
