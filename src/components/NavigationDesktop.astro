---
import { linksData } from '@/data/layouts/links';
import Link from '@/components/layout/Link.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { isCurrentPath } from '@/utils/isCurrentPath';
---

<div class="desktop-nav">
  <ul>
    {
      linksData.map((item) => (
        <li>
          <Link
            href={item.href}
            title={item.title}
            variant="bar"
            current={isCurrentPath(Astro.url.pathname, item.href)}
          />
        </li>
      ))
    }
  </ul>
  <ThemeToggle />
</div>

<style>
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .desktop-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }
  }
</style>
