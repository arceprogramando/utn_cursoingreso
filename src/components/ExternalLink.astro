---
interface Props {
  href: string;
  class?: string;
  download?: string;
  label?: string;
}

const { href, class: className, download, label } = Astro.props;
const external = /^https?:\/\//.test(href);
const hint = ' (se abre en una pestaña nueva)';
const accessibleLabel =
  label && external && !label.toLowerCase().includes('pestaña nueva') ? `${label}${hint}` : label;
---

<a
  href={href}
  class={className}
  download={download}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  aria-label={accessibleLabel}
>
  <slot />
  {external && !accessibleLabel && <span class="sr-only">{hint}</span>}
</a>
