---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import addSpaceBeforeSecondUppercase from '@/utils/addSpaceBeforeSecondUppercase';

async function loadTags() {
  const matchedCareerPosts = await getCollection('career');
  const careerPosts = Object.values(matchedCareerPosts);

  const allPosts = [...careerPosts];

  const allTags = Array.from(new Set(allPosts.flatMap((post) => post.data?.tags || [])));

  allTags.sort((a, b) => a.localeCompare(b));

  return {
    allTags,
  };
}

const { allTags } = await loadTags();

const title = 'Tecnicatura en Programación - Índice de temas';
const subTitle = 'Temas';

---

<BaseLayout
  title={title}
  subTitle={subTitle}
  description="Lista de temas usados para agrupar las materias y los apuntes."
>
  {
    allTags.length > 0 ? (
      <ul class="tag-index" aria-label="Temas">
        {allTags.map((tag) => (
          <li>
            <a class="tag-item" href={`/tags/${tag.toLowerCase()}`}>
              {addSpaceBeforeSecondUppercase(tag)}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p>No hay temas disponibles.</p>
    )
  }
</BaseLayout>

<style>
  .tag-index {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 42rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.35rem 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--bg-tertiary) 75%, transparent);
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
  }

  .tag-item:hover {
    border-color: var(--accent-2);
  }
</style>
