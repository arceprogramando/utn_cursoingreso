---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Image from 'astro/components/Image.astro';
import { fetchCollaborators } from '@/data/collaborator';
export const prerender = true;
const subTitle = 'Colaboradores';
const title = 'Colaboradores de la Tecnicatura en Programación';
const apiUrl = 'https://apicollaborator.vercel.app/';

const { colaboradores, errorMessage } = await fetchCollaborators(apiUrl);
---

<BaseLayout
  title={title}
  subTitle={subTitle}
  description="Personas que colaboran con los apuntes de la Tecnicatura Universitaria en Programación."
>
  <div
    class="flex flex-col justify-center items-center container mx-auto text-center"
  >
    {
      errorMessage ? (
        <p role="alert">{errorMessage}</p>
      ) : (
        <ul class="collaborator-list" aria-label="Personas que colaboran">
          {colaboradores.map((colaborador) => (
            <li>
              <article class="collaborator-card">
              <h2 class="collaborator-name">{colaborador.login}</h2>
              <Image
                src={colaborador.avatar_url}
                alt=""
                loading="lazy"
                width="96"
                height="96"
                class="collaborator-photo"
              />
              <p class="collaborator-role">
                {colaborador.description
                  ? colaborador.description
                  : 'Colaboración en el sitio'}
              </p>
              {colaborador.contributions && (
                <p class="collaborator-contributions">
                  {colaborador.contributions} contribuciones
                </p>
              )}
              <a
                href={colaborador.html_url}
                target="_blank"
                rel="noopener noreferrer"
                class="github-link"
                aria-label={`Perfil de ${colaborador.login} en GitHub (se abre en una pestaña nueva)`}
              >
                <Icon name="github" width={24} height={24} aria-hidden="true" />
              </a>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .collaborator-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collaborator-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 16rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    text-align: center;
  }

  .collaborator-photo {
    width: 6rem;
    height: 6rem;
    border-radius: 999px;
    border: 2px solid var(--border);
    object-fit: cover;
  }

  .collaborator-name {
    margin: 0;
    font-size: 1.25rem;
  }

  .collaborator-name,
  .collaborator-contributions {
    color: var(--text-primary);
  }

  .collaborator-role {
    color: var(--text-secondary);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--btn-primary);
    color: var(--btn-primary-text);
  }

  .github-link:hover {
    background: var(--btn-primary-hover);
  }
</style>
