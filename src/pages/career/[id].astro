---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Prose from '@/components/Prose.astro';
import addSpaceBeforeSecondUppercase from '@/utils/addSpaceBeforeSecondUppercase';
import { careerSlug } from '@/utils/careerSlug';

export async function getStaticPaths() {
  const career = await getCollection('career');

  return career.map((career) => ({
    params: { id: careerSlug(career.id) },
    props: { career },
  }));
}

const { career } = Astro.props;
const { data } = career;
const { image, title, totalTimeClass, totalExam, totalTime, professor, downloadUrl, pubDate, author, tags, description } = data;

const { Content } = await render(career);

const keywords = tags.map((tag) => addSpaceBeforeSecondUppercase(tag)).join(', ');

export const prerender = true;
---

<style>
  .back-link,
  .download-note,
  .tag-link {
    color: var(--accent);
    font-weight: 700;
    text-underline-offset: 0.15em;
  }

  .download-note,
  .tag-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--bg-tertiary) 70%, transparent);
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .tag-link:hover,
  .download-note:hover {
    border-color: var(--accent-2);
  }

  .professor {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.15rem 0.55rem;
    border-radius: 0.25rem;
    background: var(--bg-tertiary);
    font-weight: 700;
  }

  .subject-hero {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    width: min(100%, 42rem);
    margin: 0.5rem 0 1.5rem;
  }

  .subject-cover {
    width: min(100%, 15rem);
    height: auto;
    border-radius: 12px;
  }

  .subject-facts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    min-width: min(100%, 16rem);
  }

  .subject-hours {
    display: grid;
    grid-template-columns: repeat(3, minmax(4.5rem, 1fr));
    gap: 0.75rem;
    width: 100%;
    margin: 0;
  }

  .subject-hours dt {
    font-weight: 700;
  }

  .subject-hours dd {
    margin: 0.15rem 0 0;
  }

  .subject-hours div,
  .subject-professor {
    text-align: center;
  }

  .subject-professor {
    margin: 0;
  }

  .subject-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: min(100%, 48rem);
  }

  .subject-body > p {
    margin: 0;
  }

  .subject-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
</style>

<BaseLayout title={`Apunte de ${addSpaceBeforeSecondUppercase(title)}`} subTitle={title} description={description} keywords={keywords}>
  <a href="/career" class="back-link">Volver a materias</a>

  <div class="subject-hero">
    {
      image && image.url && (
        <img
          src={image.url}
          width="240"
          height="160"
          decoding="async"
          class="subject-cover"
          alt={image.alt || `Portada del apunte de ${title}`}
          loading="eager"
        />
      )
    }

    <div class="subject-facts">
      <dl class="subject-hours">
        <div>
          <dt>Cursada</dt>
          <dd>{totalTimeClass} h</dd>
        </div>
        <div>
          <dt>Examen</dt>
          <dd>{totalExam} h</dd>
        </div>
        <div>
          <dt>Total de clase</dt>
          <dd>{totalTime} h</dd>
        </div>
      </dl>

      <p class="subject-professor">
        Profesor o profesora:
        <span class="professor">{professor || 'A confirmar'}</span>
      </p>

      {
        downloadUrl && (
          <a href={downloadUrl} download={`${title.replace(/ /g, '_')}.pdf`} class="download-note">
            Descargar apunte de {title}
          </a>
        )
      }
    </div>
  </div>

  <div class="subject-body">
    <p>
      Publicado el
      <time datetime={new Date(pubDate).toISOString().slice(0, 10)}>
        {new Date(pubDate).toLocaleDateString('es-AR')}
      </time>
    </p>
    {author && <p>Escrito por {author}</p>}
    <Prose>
      <Content />
    </Prose>

    <ul class="subject-tags" aria-label={`Temas de ${title}`}>
      {
        tags.map((tag) => (
          <li>
            <a class="tag-link" href={`/tags/${tag.toLowerCase()}`}>
              {addSpaceBeforeSecondUppercase(tag)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
