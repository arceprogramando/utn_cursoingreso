---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CardPostImage from '@/components/CardPostImage.astro';
import { getCollection } from 'astro:content';
import { careerSlug } from '@/utils/careerSlug';

const title = 'Materias de la Tecnicatura Universitaria en Programación';
const subTitle = 'Materias';
const careerEntries = await getCollection('career');

careerEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

interface SectionTitle {
  title: string;
  minOrder: number;
  maxOrder: number;
}

const sectionTitles : SectionTitle[] = [
  { title: 'Curso de ingreso', minOrder: 0, maxOrder: 2 },
  { title: 'Primer cuatrimestre', minOrder: 3, maxOrder: 6 },
  { title: 'Segundo cuatrimestre', minOrder: 7, maxOrder: 10 },
  { title: 'Tercer cuatrimestre', minOrder: 11, maxOrder: 14 },
  { title: 'Cuarto cuatrimestre', minOrder: 15, maxOrder: 20 }
];
---

<BaseLayout
  title={title}
  subTitle={subTitle}
  description="Materias y apuntes de la Tecnicatura Universitaria en Programación de la UTN, ordenadas por el Plan 2024."
>
  <div class="career-index">
    <p class="career-note">
      El orden es el del Plan 2024. Las horas de clase, el trabajo autónomo y los créditos están
      en el <a href="/#plan">inicio</a>.
    </p>
    {
      sectionTitles.map(({ title: sectionTitle, minOrder, maxOrder }) => {
        const sectionEntries = careerEntries.filter(
          ({ data }) => data.order >= minOrder && data.order <= maxOrder
        );

        if (sectionEntries.length === 0) return null;
        const headingId = sectionTitle.toLowerCase().replace(/\s+/g, '-');

        return (
          <section aria-labelledby={headingId}>
            <h2 id={headingId}>{sectionTitle}</h2>
            <ul>
              {sectionEntries.map(({ data, id }, index) => (
                <CardPostImage
                  url={`/career/${careerSlug(id)}`}
                  tag={data.image?.url || ''}
                  alt={data.image?.alt || data.title}
                  title={data.title}
                  loading={minOrder === 0 && index < 3 ? 'eager' : 'lazy'}
                />
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .career-index {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    width: 100%;
    max-width: 48rem;
  }

  .career-index h2 {
    margin: 0;
    text-align: center;
    font-size: 1.5rem;
  }

  .career-note {
    margin: 0 auto;
    max-width: 36rem;
    text-align: center;
    color: var(--text-secondary);
  }

  .career-note a {
    color: var(--accent);
    font-weight: 700;
  }

  .career-index ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
  }
</style>
