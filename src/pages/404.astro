---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  subTitle="Página no encontrada"
  description="La página que buscás no existe en el sitio de la Tecnicatura Universitaria en Programación."
>
  <p class="not-found">
    No encontramos esa dirección. Volvé al
    <a href="/">inicio</a>
    o entrá a
    <a href="/career">las materias</a>.
  </p>
</BaseLayout>

<style>
  .not-found {
    max-width: 40rem;
    text-align: center;
    font-size: 1.125rem;
  }

  .not-found a {
    color: var(--accent);
    font-weight: 700;
    text-underline-offset: 0.15em;
  }
</style>
