---
import Social from '@/components/Social.astro';
import ExternalLink from '@/components/ExternalLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/data/projects';

const title = 'Proyectos de Alumnos de la Tecnicatura en Programación';
const subTitle = 'Proyectos UTN';
---

<BaseLayout
  title={title}
  subTitle={subTitle}
  description="Proyectos de Alumnos de la Tecnicatura en Programación"
>
  <div
    class="flex flex-col justify-center items-center container mx-auto text-center"
  >
    <h2 class="text-2xl font-bold pb-4">
      Recopilación de proyectos hechos por los estudiantes de la UTN
    </h2>
  </div>
  <p class="max-w-2xl text-center mb-6">
    Si cursás la tecnicatura y querés sumar un proyecto, abrí un issue en el
    <ExternalLink href="https://github.com/arceprogramando/utn_cursoingreso/issues">
      repositorio
    </ExternalLink>
    con el título, una descripción, las tecnologías y el enlace.
  </p>

  <ul class="project-list">
    {
      projects.map((project) => (
        <li class="project-card">
          <article>
            <h3 class="project-title">{project.title}</h3>
            <img
              src={project.image}
              alt={`Captura del proyecto ${project.title}`}
              width="400"
              height="225"
              class="project-image"
            />
            <p class="project-description">{project.description}</p>
            <ul class="project-actions" aria-label={`Enlaces de ${project.title}`}>
              {project.link && (
                <li>
                  <ExternalLink
                    href={project.link}
                    class="project-link"
                    label={`Sitio web de ${project.title}`}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </svg>
                  </ExternalLink>
                </li>
              )}
              <li>
                <Social
                  platform={project.github}
                  red="github"
                  icon="github"
                  alt={`Repositorio de ${project.title} en GitHub`}
                />
              </li>
            </ul>
            <ul class="project-tags" aria-label={`Tecnologías de ${project.title}`}>
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .project-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-card {
    width: 100%;
    max-width: 18rem;
    overflow: hidden;
    border: 2px solid var(--border-light);
    border-radius: 0.75rem;
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .project-title {
    margin: 0;
    padding: 1rem 1rem 0.35rem;
    color: var(--text-primary);
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .project-image {
    width: 100%;
    height: auto;
  }

  .project-description {
    margin: 0;
    padding: 0.35rem 1rem 0;
    color: var(--text-secondary);
  }

  .project-actions,
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.75rem 1rem 0;
    list-style: none;
  }

  .project-tags {
    padding-bottom: 1rem;
  }

  .project-tags li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-size: 0.85rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--text-primary);
  }

  .project-list a {
    color: var(--accent);
    font-weight: 700;
  }

  p a {
    color: var(--accent);
    text-underline-offset: 0.15em;
  }
</style>
